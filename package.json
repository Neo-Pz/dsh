      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.6",
    "iflow-adapter-sdk": "^0.1.0",
    "iflow-domain": "^0.1.0",
    "iflow-protocol": "^0.1.0"
  }
